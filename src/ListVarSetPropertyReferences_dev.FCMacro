# =====================================================================
# DEVELOPMENT COPY -- do not install this file.
# The distributable build is ListVarSetPropertyReferences.FCMacro at the
# project root, generated by scripts/build_single_file.py (which embeds the
# companion src/varset_usage_core_dev.py). See README.md.
# =====================================================================

"""
ListVarSetPropertyReferences_dev.FCMacro
========================================

Pick a VarSet and one of its properties, then list every expression in the
active document (and, by default, in every other open document) that
references it. Lines whose expression points at a document that is not
open are flagged with ``(!)`` -- such bindings are dead (typically after
the referenced file was renamed) and silently keep their last computed
value.

Target: FreeCAD 1.1+ (Qt6 / PySide6).

Development layout: the companion module ``varset_usage_core_dev.py`` sits next
to this file and holds the headless logic (see tests/ for coverage). It is
loaded explicitly from the macro's own directory via importlib -- no
sys.path mutation -- so both files can live anywhere, e.g. in your user
Macro folder or a subfolder of it. Pasted into the Python console (where
``__file__`` is absent), a plain import is attempted instead.

Distribution layout: ``scripts/build_single_file.py`` produces a self-contained
single-file build in which the full core source is embedded as the
``_EMBEDDED_CORE_SOURCE`` string literal between the EMBEDDED CORE markers
below; the loader prefers that copy over any sibling file, so the
distributed macro needs nothing but itself.
"""

import importlib.util
import os

import FreeCAD as app
from PySide6 import QtGui, QtWidgets

DIALOG_TITLE = "VarSet Property References"
_CORE_FILENAME = "varset_usage_core_dev.py"

# __file__ is defined when FreeCAD runs a macro from a file (see
# Base::InterpreterSingleton::runFile); it is absent when the code is pasted
# into the Python console, in which case a plain import is attempted.
_MACRO_DIR = (
    os.path.dirname(os.path.abspath(__file__)) if "__file__" in globals() else None
)

# ---------------------------------------------------------------------------
# Single-file distribution build (scripts/build_single_file.py) replaces the
# region below with an _EMBEDDED_CORE_SOURCE string literal holding the full
# source of varset_usage_core_dev.py. Development builds leave it empty and
# load the sibling file instead. Do not edit between these markers by hand.
# === BEGIN EMBEDDED CORE (generated by scripts/build_single_file.py) ===
# === END EMBEDDED CORE ===
# ---------------------------------------------------------------------------


def _fatal(message):
    """Show an error dialog and stop."""
    QtWidgets.QMessageBox.critical(None, DIALOG_TITLE, message)


def _load_core():
    """Load the headless core module without mutating global state.

    Sources, in priority order:

    1. An embedded copy (``_EMBEDDED_CORE_SOURCE``) -- present only in the
       single-file distribution build produced by scripts/build_single_file.py.
       Executing it into a fresh module keeps the session clean and makes
       the distributed file fully self-contained.
    2. A sibling ``varset_usage_core_dev.py`` next to this macro (development
       layout), loaded by explicit path so no ``sys.path`` entry persists
       for the rest of the session (and so a same-named module elsewhere
       cannot shadow or be shadowed by it).
    3. Whatever ``sys.path`` already offers (console-paste fallback; the
       user Macro folder is on sys.path at startup).

    Returns ``None`` when no source can be loaded.
    """
    embedded = globals().get("_EMBEDDED_CORE_SOURCE")
    if embedded is not None:
        import types

        module = types.ModuleType("varset_usage_core_embedded")
        module.__doc__ = (
            "Embedded copy of varset_usage_core_dev (single-file build).")
        exec(compile(embedded, "<embedded:varset_usage_core_dev>", "exec"),
             module.__dict__)
        return module
    if _MACRO_DIR is not None:
        path = os.path.join(_MACRO_DIR, _CORE_FILENAME)
        if os.path.isfile(path):
            spec = importlib.util.spec_from_file_location(
                "varset_usage_core_dev", path)
            module = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(module)
            return module
    try:
        # Console-paste fallback: rely on whatever sys.path already offers.
        import varset_usage_core_dev
    except ImportError:
        return None
    return varset_usage_core_dev


def _standard_baseline():
    """Standard-property set of a bare App::VarSet, probed live.

    Deriving the baseline from a throwaway object (instead of trusting the
    pinned set in the core) keeps the variable list correct if a future
    FreeCAD release adds standard properties to DocumentObject/VarSet.
    Falls back to the core's pinned set if probing fails.
    """
    try:
        probe_doc = app.newDocument("VarSetUsageProbe")
        try:
            probe = probe_doc.addObject("App::VarSet", "Probe")
            return frozenset(probe.PropertiesList)
        finally:
            app.closeDocument(probe_doc.Name)
    except Exception:
        return core.STANDARD_PROPERTIES


try:
    core = _load_core()
except Exception as exc:  # broader than ImportError: also catches a broken
    core = None           # companion that exists but fails mid-import
    _load_error = "{}: {}".format(type(exc).__name__, exc)
else:
    _load_error = None

if core is None:
    detail = "\n\n({})".format(_load_error) if _load_error else ""
    _fatal(
        "Could not load 'varset_usage_core_dev'.{}\n\n"
        "Place varset_usage_core_dev.py in the same folder as this macro "
        "and try again.".format(detail)
    )


class UsageDialog(QtWidgets.QDialog):
    """Modal dialog: choose a VarSet and a property, see its usages."""

    def __init__(self, document, parent=None):
        super().__init__(parent)
        self._document = document
        # Selections are looked up by the stored internal Name (unique per
        # document), never by row index, so the combos stay in sync even if
        # their contents are ever reordered or filtered.
        self._varsets = core.find_varsets(document)
        self._varsets_by_name = {v.Name: v for v in self._varsets}
        # Expressions cannot change while this modal dialog is open (exec()
        # disables the main window), so one snapshot per open document taken
        # here is provably fresh for the whole session and spares each
        # selection change a rescan -- including of every other open file.
        self._snapshots = {
            id(d): list(core.iter_expressions(d))
            for d in app.listDocuments().values()
        }
        # Names of all open documents, taken with the snapshots above so
        # both stay consistent for the whole modal session. Used to flag
        # expressions that reference a document which is not open (dead
        # cross-document bindings).
        self._open_doc_names = set(app.listDocuments())
        # Live-probe the standard-property baseline (falls back to the
        # pinned core set if probing fails).
        self._standard = _standard_baseline()
        self._build_ui()
        self._populate_varsets()

    # -- construction -------------------------------------------------------

    def _build_ui(self):
        self.setWindowTitle(DIALOG_TITLE)

        layout = QtWidgets.QVBoxLayout(self)

        row = QtWidgets.QHBoxLayout()
        row.addWidget(QtWidgets.QLabel("VarSet:"))
        self.varset_combo = QtWidgets.QComboBox()
        row.addWidget(self.varset_combo, stretch=1)
        row.addWidget(QtWidgets.QLabel("Property:"))
        self.property_combo = QtWidgets.QComboBox()
        row.addWidget(self.property_combo, stretch=1)
        layout.addLayout(row)

        # Cross-file usages exist: expressions may reference this VarSet
        # from any other open document via DocName#Object.Property, so by
        # default scan every open document, not just the active one.
        self.scan_all_cb = QtWidgets.QCheckBox(
            "Include other open documents")
        self.scan_all_cb.setChecked(True)
        layout.addWidget(self.scan_all_cb)

        self.results = QtWidgets.QTextEdit()
        self.results.setReadOnly(True)
        font = self.font()
        # Monospace makes expressions easier to read. Note: QFont.setFixed()
        # and QFont.Fixed do NOT exist in the PySide6 6.8 bundled with
        # FreeCAD 1.1 (verified empirically, research/PROBE_REVIEW2.txt);
        # StyleHint.Monospace is the working equivalent.
        font.setStyleHint(QtGui.QFont.StyleHint.Monospace)
        self.results.setFont(font)
        self.results.setPlaceholderText(
            "Select a VarSet and a property to list its usages."
        )
        layout.addWidget(self.results, stretch=1)

        self.resize(760, 540)

        # 'activated' fires only on user interaction, never while the combos
        # are populated programmatically (currentIndexChanged would fire on
        # every addItem/clear). Note: the signal delivers the new index (int),
        # not the widget.
        self.varset_combo.activated.connect(self._on_varset_changed)
        self.property_combo.activated.connect(self._on_property_changed)

    def _populate_varsets(self):
        self.varset_combo.clear()
        for varset in self._varsets:
            # Fall back to the internal Name when the Label was cleared, so
            # the entry is never blank.
            self.varset_combo.addItem(varset.Label or varset.Name, varset.Name)

    # -- slots ---------------------------------------------------------------

    def _on_varset_changed(self, index: int):
        varset = self._varsets_by_name[self.varset_combo.currentData()]
        self.property_combo.clear()
        self.property_combo.addItems(
            core.user_properties(varset, self._standard))
        if not self.property_combo.count():
            self.results.setPlainText(
                "This VarSet has no user-defined properties."
            )

    def _on_property_changed(self, index: int):
        name = self.varset_combo.currentData()
        if name is None:  # combo empty (should not happen; guard anyway)
            return
        varset = self._varsets_by_name[name]
        prop = self.property_combo.itemText(index)
        if self.scan_all_cb.isChecked():
            docs = [self._document] + [
                d for d in app.listDocuments().values()
                if d is not self._document
            ]
            matches = core.find_usages_all(
                docs, varset, prop, snapshots=self._snapshots)
            text = core.format_report_multi(
                matches, self._document,
                open_doc_names=self._open_doc_names)
        else:
            matches = core.find_usages(
                self._document, varset, prop,
                expressions=self._snapshots.get(id(self._document)))
            text = core.format_report(
                matches, open_doc_names=self._open_doc_names)
        if matches:
            text = "{} usage(s):\n\n{}".format(len(matches), text)
        self.results.setPlainText(text)


# Strictly unnecessary -- the local reference inside main() already keeps
# the dialog alive throughout exec() -- but held here as GC protection in
# case main()'s frame is unwound unexpectedly while the dialog runs.
_dialog_ref = None


def main():
    global _dialog_ref

    if core is None:
        return  # _fatal() already explained why loading failed

    doc = app.ActiveDocument
    if doc is None:
        _fatal("No active document found.")
        return

    if not core.find_varsets(doc):
        _fatal(
            "No {} objects found in '{}'.".format(core.VARSET_TYPE_ID, doc.Label)
        )
        return

    _dialog_ref = UsageDialog(doc)
    try:
        _dialog_ref.exec()
    finally:
        _dialog_ref = None


if __name__ == "__main__":
    try:
        main()
    except Exception:
        import traceback

        traceback.print_exc()
        _fatal("Unexpected error - see the Python console for details.")
